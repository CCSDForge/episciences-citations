# define your env variables for the test env here
KERNEL_CLASS='App\Kernel'
APP_SECRET='$ecretf0rt3st'
# Mode weak : affiche seulement le nombre de deprecations sans détails
SYMFONY_DEPRECATIONS_HELPER=weak
PANTHER_APP_ENV=panther
PANTHER_ERROR_SCREENSHOT_DIR=./var/error-screenshots

# Database configuration for tests
# Using SQLite in-memory for fast unit tests
DATABASE_URL="sqlite:///:memory:"

# Mock external services URLs for testing
APP_GROBID_URL="http://mock-grobid"
GROBID_URL="http://mock-grobid"
SEMANTIC_SCHOLAR_API_URL="http://mock-semantic"
API_RIGHT_URL="https://api.example.org"
API_S2_KEY="test-s2-key"
EPISCIENCES_FORCE_HTTP=false
FORCE_HTTPS=true

# CAS configuration for tests
CAS_HOST=cas.example.org
CAS_PATH=/cas
CAS_PORT=443
CAS_CA=false
CAS_HANDLE_LOGOUT_REQUEST=false
CAS_LOGIN_TARGET=https://cas.example.org
CAS_LOGOUT_TARGET=https://cas.example.org
CAS_FORCE=false
CAS_GATEWAY=false

APP_SOLR_REFERENCE_ENRICHMENT_ENABLED=false
APP_SOLR_BASE_URL="http://mock-solr/solr"
APP_SOLR_COLLECTION="ref_pps"
APP_SOLR_BATCH_SIZE=100
APP_OPENALEX_ENABLED=false
APP_OPENALEX_API_URL="http://mock-openalex/works/"
APP_OPENALEX_MAILTO="test@example.org"
APP_OPENALEX_API_KEY=
APP_OPENALEX_DAILY_BULK_QUOTA=10000

# Test environment settings
APP_ENV=test
APP_DEBUG=1

# CORS configuration for API tests
DOMAIN_CORS="episciences.org"
API_EXTRACT_TOKEN=test-extract-token
